import { Postgres } from ".src.postgres"
import { DbError, Connection } from "std.db"

// Helper — fresh isolated connection per test (uses a test database)
fun testDb(): Connection {
    return Postgres.connect("postgres://leodouglas@localhost/eiwa")
}

// --- Connection ---

test "postgres: driver connects and returns a connection" {
    val db = testDb()
    assert(db != null)
    db.close()
}

// --- Execute DDL ---

test "postgres: execute creates a table without error" {
    use(Postgres.connect("postgres://leodouglas@localhost/eiwa")) {
        it.execute("DROP TABLE IF EXISTS pg_test_users")
        it.execute("CREATE TABLE pg_test_users (id SERIAL PRIMARY KEY, name TEXT NOT NULL)")
    }
}

// // --- Parameterized insert + query ---

test "postgres: insert and query rows" {
    val db = testDb()
    db.execute("DELETE FROM pg_test_users")
    db.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["Alice"])
    db.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["Bob"])

    val result = db.query("SELECT name FROM pg_test_users ORDER BY id")
    val rows = result.rows()
    val names = MutableList<String>()
    for (result.rows()) { row ->
        val name = row.string("name")
        names.add(name)
    }

    assert(names.size() == 2)
    assert(names.get(0) == "Alice")
    assert(names.get(1) == "Bob")
    db.close()
}

// --- rowsAffected ---

test "postgres: rowsAffected reflects number of modified rows" {
    val db = testDb()
    db.execute("DELETE FROM pg_test_users")
    db.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["X"])
    db.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["Y"])

    val result = db.query("UPDATE pg_test_users SET name = 'Z'")
    assert(result.rowsAffected() == 2)
    db.close()
}

// --- Prepared statement ---

test "postgres: prepare and execute a named statement" {
    val db = testDb()
    db.execute("DELETE FROM pg_test_users")
    db.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["Charlie"])

    val stmt = db.prepare("SELECT name FROM pg_test_users WHERE name = $1")
    val result = stmt.query(["Charlie"])
    val names = MutableList<String>()
    for (result.rows()) { row ->
        names.add(row.string("name"))
    }

    assert(names.size() == 1)
    assert(names.get(0) == "Charlie")
    db.close()
}

// --- Row field types ---

test "postgres: row returns correct int and string values" {
    val db = testDb()
    db.execute("DELETE FROM pg_test_users")
    db.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["TypeCheck"])

    val result = db.query("SELECT id, name FROM pg_test_users")
    for (result.rows()) { row ->
        assert(row.int("id") > 0)
        assert(row.string("name") == "TypeCheck")
    }

    db.close()
}

// --- Async: concurrent queries ---
// TODO: should work concurrently
test "postgres: two concurrent queries do not block each other" {

    val t1 = task {
        val db1 = testDb()
        var result = ""
        val r = db1.query("SELECT 'conn1' AS tag")
        for (r.rows()) { row ->
            result = row.string("tag")
        }
        db1.close()
        result
    }

    val db2 = testDb()
    val t2 = task {
        var result = ""
        val r = db2.query("SELECT 'conn2' AS tag")
        for (r.rows()) { row ->
            result = row.string("tag")
        }
        result
    }
    
    assert(t2.await() == "conn2")
    db2.close()

    assert(t1.await() == "conn1")
}

// --- Closed connection guards ---

test "postgres: query throws on closed connection" {
    val db = testDb()
    db.close()
    var caught = false
    try {
        db.query("SELECT 1")
    } catch (e: DbError) {
        caught = true
        assert(e.message == "Connection is closed")
    }
    assert(caught == true)
}

test "postgres: execute throws on closed connection" {
    val db = testDb()
    db.close()
    var caught = false
    try {
        db.execute("SELECT 1")
    } catch (e: DbError) {
        caught = true
        assert(e.message == "Connection is closed")
    }
    assert(caught == true)
}

test "postgres: prepare throws on closed connection" {
    val db = testDb()
    db.close()
    var caught = false
    try {
        db.prepare("SELECT 1")
    } catch (e: DbError) {
        caught = true
        assert(e.message == "Connection is closed")
    }
    assert(caught == true)
}

test "postgres: close is idempotent on closed connection" {
    val db = testDb()
    db.close()
    db.close()
    // if we reach here, no crash
    assert(true)
}

// --- PgPool & BoundStatement tests ---

test "postgres: pool executes queries transparently" {
    val pool = Postgres.pool("postgres://leodouglas@localhost/eiwa", 3)
    val res = pool.query("SELECT 42 AS val")
    var value = 0
    for (res.rows()) { row ->
        value = row.int("val")
    }
    assert(value == 42)
    pool.close()
}

test "postgres: pool handles fluent parameter binding" {
    val pool = Postgres.pool("postgres://leodouglas@localhost/eiwa", 2)
    pool.execute("DELETE FROM pg_test_users")
    
    val stmt = pool.prepare("INSERT INTO pg_test_users(name) VALUES($1)")
    stmt.bind("FluentUser").execute()

    val check = pool.query("SELECT name FROM pg_test_users WHERE name = $1", ["FluentUser"])
    assert(check.rows().size() == 1)
    pool.close()
}

test "postgres: pool transactions commit successfully" {
    val pool = Postgres.pool("postgres://leodouglas@localhost/eiwa", 2)
    pool.execute("DELETE FROM pg_test_users")

    pool.transaction { tx ->
        tx.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["TxUser1"])
        tx.execute("INSERT INTO pg_test_users(name) VALUES($1)", ["TxUser2"])
    }

    val res = pool.query("SELECT COUNT(*) AS total FROM pg_test_users")
    var total = 0
    for (res.rows()) { row ->
        total = row.int("total")
    }
    assert(total == 2)
    pool.close()
}

test "postgres: pool handles concurrent tasks under connection limit" {
    val pool = Postgres.pool("postgres://leodouglas@localhost/eiwa", 2)

    val t1 = task {
        val r = pool.query("SELECT 1 AS num")
        var n = 0
        for (r.rows()) { row -> n = row.int("num") }
        n
    }

    val t2 = task {
        val r = pool.query("SELECT 2 AS num")
        var n = 0
        for (r.rows()) { row -> n = row.int("num") }
        n
    }

    val t3 = task {
        val r = pool.query("SELECT 3 AS num")
        var n = 0
        for (r.rows()) { row -> n = row.int("num") }
        n
    }

    assert(t1.await() == 1)
    assert(t2.await() == 2)
    assert(t3.await() == 3)

    pool.close()
}


test "postgres: values longer than 512 chars round-trip whole" {
    val db = testDb()
    db.execute("DROP TABLE IF EXISTS pg_test_long")
    db.execute("CREATE TABLE pg_test_long (id SERIAL PRIMARY KEY, payload TEXT NOT NULL)")
    var big = ""
    repeat(60) { i ->
        big = big + "abcdefghijklmnopqrstuvwxyz0123456789"
    }
    assert(big.length == 2160, "fixture")
    db.execute("INSERT INTO pg_test_long(payload) VALUES($1)", [big])
    val rows = db.query("SELECT payload FROM pg_test_long").rows()
    assert(rows.size() == 1, "count")
    assert(rows.get(0).string("payload") == big, "whole")
    db.execute("DROP TABLE pg_test_long")
    db.close()
}
